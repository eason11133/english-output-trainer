{
  "expo": {
    "name": "English Output Trainer",
    "slug": "english-output-trainer",
    "version": "0.4.3",
    "orientation": "portrait",
    "scheme": "englishoutputtrainer",
    "icon": "./assets/images/EOT_founder_approved_app_icon_v1.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.easonsystems.englishoutputtrainer",
      "buildNumber": "11"
    },
    "android": {
      "package": "com.easonsystems.englishoutputtrainer",
      "versionCode": 11,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/images/EOT_founder_approved_app_icon_v1.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/EOT_founder_approved_app_icon_v1.png",
        "backgroundColor": "#F7F3ED"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sqlite",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/EOT_founder_approved_app_icon_v1.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3ED"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "releaseLabel": "build-11-production-frontend-ota-2026-09-29",
      "router": {},
      "eas": {
        "projectId": "9f32a9ee-526a-4cb8-8c8c-4da9431b1150"
      }
    },
    "owner": "eason-systems",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9f32a9ee-526a-4cb8-8c8c-4da9431b1150",
      "assetPatternsToBeBundled": [
        "app/**/*",
        "components/**/*",
        "src/**/*",
        "assets/images/**/*",
        "assets/expo.icon/**/*",
        "node_modules/**/*"
      ]
    }
  }
}
