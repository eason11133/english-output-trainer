{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": ".domain-test-build",
    "noEmitOnError": true,
    "types": [],
    "resolveJsonModule": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/learner-truth/**/*.ts",
    "src/product/**/*.ts",
    "src/curriculum/**/*.ts",
    "src/teacher-runtime/**/*.ts",
    "src/experience/teacherDecisionExperience.ts",
    "src/application/stage4/**/*.ts",
    "src/application/stage5a/**/*.ts",
    "src/application/access/**/*.ts",
    "src/application/evidence/**/*.ts",
    "src/application/exam/**/*.ts",
    "src/application/learner/**/*.ts",
    "src/application/learning/**/*.ts",
    "src/application/session/**/*.ts",
    "src/application/teacher/**/*.ts",
    "src/application/v4/**/*.ts",
    "src/application/stage2/**/*.ts",
    "src/repositories/EvidenceRepository.ts",
    "src/repositories/InMemoryEvidenceRepository.ts",
    "src/architecture/**/*.ts",
    "src/evaluation/**/*.ts",
    "src/teaching/**/*.ts",
    "src/domain-test-shims.d.ts",
    "src/persistence/treatmentChronology.ts",
    "src/persistence/operationalTypes.ts",
    "src/specializations/writing/**/*.ts",
    "src/specializations/translation/**/*.ts",
    "src/specializations/language/**/*.ts",
    "src/content/**/*.ts",
    "src/assessment/**/*.ts",
    "src/lesson-runtime/**/*.ts",
    "src/experience/outputWorkspaceVM.ts",
    "src/experience/lessonExperience.ts",
    "src/experience/capabilities.ts",
    "src/experience/waveNStatus.ts",
    "src/experience/practiceProduct.ts",
    "src/experience/myEnglishAbility.ts",
    "src/experience/resultNavigation.ts",
    "src/experience/firstUseState.ts",
    "src/experience/firstDayTutorialState.ts",
    "src/ui/**/*.ts",
    "src/reliability/**/*.ts",
    "src/lookup/**/*.ts",
    "src/authentic-input/**/*.ts",
    "src/product-policy/**/*.ts",
    "src/longitudinal/**/*.ts",
    "src/model/**/*.ts",
    "src/market-validation/privateBetaAnalytics.ts",
    "src/persistence/dataCorpusTypes.ts",
