{
  "name": "english-output-trainer",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "eas-build-post-install": "node scripts/materialize-bundled-corpus.mjs",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "teacher": "node --env-file-if-exists=.env.teacher.local coach-server/teacher-server.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:domain": "tsc -p tsconfig.domain-tests.json && node --test tests/domain/learningCore.test.cjs tests/domain/teacherCore.test.cjs tests/domain/stage1ArchitectureV4.test.cjs tests/domain/learningBlocksV4.test.cjs tests/domain/contentCoverage.test.cjs tests/domain/contentCoverageCensus.test.cjs",
    "census:content-coverage": "tsc -p tsconfig.domain-tests.json && node scripts/generate-content-coverage-census.cjs",
    "test:scenario": "tsc -p tsconfig.domain-tests.json && node --test tests/scenarios/teacherCoreScenario.test.cjs tests/scenarios/stage12V3Gate.test.cjs",
    "test:eval": "tsc -p tsconfig.domain-tests.json && node scripts/run-stage12-v3-evals.cjs",
    "test:architecture": "tsc -p tsconfig.domain-tests.json && node scripts/run-stage1-v4-architecture.cjs",
    "test:stage2": "tsc -p tsconfig.domain-tests.json && node --test tests/scenarios/stage2V4Gate.test.cjs tests/scenarios/stage2BlockSelectionV4.test.cjs && node scripts/run-stage2-v4-evals.cjs && node scripts/run-stage2-block-selection-v4.cjs",
    "test:stage3:preflight": "node scripts/run-stage3-v4-preflight.mjs",
    "test:stage3:block-preflight": "node scripts/run-stage3-block-preflight.mjs",
    "test:stage3:block-live": "node --env-file-if-exists=.env.teacher.local scripts/run-stage3-block-live.mjs",
    "test:stage3:block-final9": "node --env-file-if-exists=.env.teacher.local scripts/run-stage3-block-final9.mjs",
    "test:stage3:block-final-source": "node --env-file-if-exists=.env.teacher.local scripts/run-stage3-block-final-source-regression.mjs",
    "capture:stage1-blocks": "node scripts/capture-stage1-block-acceptance.mjs",
    "capture:stage2-eval": "node scripts/capture-stage2-eval-lab.mjs",
    "test:stage4": "tsc -p tsconfig.domain-tests.json && node --test tests/stage4/stage4RuntimeV4.test.cjs",
    "test:stage4:live": "tsc -p tsconfig.domain-tests.json && node --env-file-if-exists=.env.teacher.local scripts/run-stage4-phase-b-live.mjs",
    "test:stage4:pdf-regression": "node --env-file-if-exists=.env.teacher.local scripts/run-stage4-pdf-vision-regression.mjs",
    "test:stage3:capability-provenance": "tsc -p tsconfig.domain-tests.json && node --env-file-if-exists=.env.teacher.local scripts/run-stage3-capability-provenance-live.mjs",
    "test:stage5a": "tsc -p tsconfig.domain-tests.json && node --test tests/stage5a/allowSliceV4.test.cjs",
    "test:wave1d": "tsc -p tsconfig.domain-tests.json && tsc -p tsconfig.wave1d-persistence-tests.json && node --test tests/domain/readingHandoffWave1D.test.cjs && node --test tests/integration/readingPersistenceWave1D.test.cjs tests/integration/learnerProjectionFrontstageWave1D.test.cjs",
    "test:main-architecture": "node scripts/run-isolated-domain-suite.cjs main-architecture tests/domain/mainArchitectureSkeleton.test.cjs scripts/run-main-architecture-gate.cjs",
    "test:product-context": "npm run test:wave-a",
    "test:wave-a": "node scripts/run-isolated-domain-suite.cjs wave-a tests/domain/productContextWaveA.test.cjs scripts/run-product-context-wave-a-gate.cjs",
    "test:english-domain": "npm run test:wave-b",
    "test:wave-b": "node scripts/run-isolated-domain-suite.cjs wave-b tests/domain/englishDomainWaveB.test.cjs scripts/run-english-domain-wave-b-gate.cjs",
    "test:learner-truth": "npm run test:wave-c",
    "test:wave-c": "node scripts/run-isolated-domain-suite.cjs wave-c tests/domain/learnerTruthWaveC.test.cjs scripts/run-learner-truth-wave-c-gate.cjs",
    "test:curriculum": "npm run test:wave-d",
    "test:wave-d": "node scripts/run-isolated-domain-suite.cjs wave-d tests/domain/curriculumOuterLoopWaveD.test.cjs scripts/run-curriculum-wave-d-gate.cjs",
    "test:wave-e": "node scripts/run-isolated-domain-suite.cjs wave-e tests/domain/teacherRuntimeWaveE.test.cjs scripts/run-teacher-runtime-wave-e-gate.cjs",
    "test:wave-gates:parallel": "node scripts/run-wave-gates-parallel.cjs",
    "test:wave-f": "node scripts/run-isolated-domain-suite.cjs wave-f tests/domain/teachingIntelligenceWaveF.test.cjs tests/domain/teachingPuzzleContract.test.cjs tests/domain/teachingPuzzleLibrary.test.cjs tests/domain/teachingPuzzleComposer.test.cjs scripts/run-teaching-intelligence-wave-f-gate.cjs",
    "test:wave-u1": "node scripts/run-u1-local-persistence-gate.cjs",
    "test:wave-h": "node scripts/run-isolated-domain-suite.cjs wave-h tests/domain/writingTeacherWaveH.test.cjs scripts/run-writing-wave-h-gate.cjs",
    "test:wave-g": "node scripts/run-isolated-domain-suite.cjs wave-g tests/domain/contentTaskWaveG.test.cjs tests/domain/teachingPuzzleContentBinding.test.cjs scripts/run-content-wave-g-gate.cjs",
    "test:wave-i": "node scripts/run-isolated-domain-suite.cjs wave-i tests/domain/translationTeacherWaveI.test.cjs scripts/run-translation-wave-i-gate.cjs",
    "test:wave-k": "node scripts/run-isolated-domain-suite.cjs wave-k tests/domain/assessmentWaveK.test.cjs scripts/run-assessment-wave-k-gate.cjs",
    "test:wave-m": "node scripts/run-isolated-domain-suite.cjs wave-m tests/domain/lessonRuntimeWaveM.test.cjs scripts/run-lesson-runtime-wave-m-gate.cjs",
    "test:wave-n": "node scripts/run-isolated-domain-suite.cjs wave-n tests/domain/productExperienceWaveN.test.cjs tests/domain/teachingPuzzleExperience.test.cjs scripts/run-product-experience-wave-n-gate.cjs",
    "test:wave-o": "node scripts/run-isolated-domain-suite.cjs wave-o tests/domain/uiSystemWaveO.test.cjs tests/domain/teachingPuzzleUI.test.cjs scripts/run-ui-wave-o-gate.cjs",
    "test:wave-v": "node scripts/run-isolated-domain-suite.cjs wave-v tests/domain/productionReliabilityWaveV.test.cjs scripts/run-production-reliability-wave-v-gate.cjs",
    "test:wave-p": "node scripts/run-isolated-domain-suite.cjs wave-p tests/domain/contextualLookupWaveP.test.cjs scripts/run-contextual-lookup-wave-p-gate.cjs",
    "test:wave-q": "node scripts/run-isolated-domain-suite.cjs wave-q tests/domain/authenticInputWaveQ.test.cjs scripts/run-authentic-input-wave-q-gate.cjs",
    "test:wave-rs": "node scripts/run-isolated-domain-suite.cjs wave-rs tests/domain/productPolicyWaveRS.test.cjs scripts/run-product-policy-wave-rs-gate.cjs",
    "test:wave-l": "node scripts/run-isolated-domain-suite.cjs wave-l tests/domain/longitudinalWaveL.test.cjs scripts/run-longitudinal-wave-l-gate.cjs",
    "test:wave-t": "node scripts/run-isolated-domain-suite.cjs wave-t tests/domain/modelLayerWaveT.test.cjs scripts/run-model-layer-wave-t-gate.cjs",
    "test:live-ai-gate": "node --test tests/domain/gsatLiveAiGate.test.mjs",
    "ai:smoke": "node --env-file-if-exists=.env.teacher.local scripts/run-gsat-live-ai-smoke.mjs",
    "test:product-cutover-v21": "node scripts/run-isolated-domain-suite.cjs product-cutover-v21 tests/domain/bigProductCutoverV21.test.cjs scripts/run-big-product-cutover-v21-gate.cjs",
    "test:ready-to-learn-v28": "node scripts/run-isolated-domain-suite.cjs ready-to-learn-v28 tests/domain/readyToLearnProductV28.test.cjs scripts/run-ready-to-learn-v28-gate.cjs",
    "pck:ingest": "node scripts/ingest-pck-assets.mjs",
    "data:acquire": "node scripts/data-corpus/acquire-data-corpus.mjs",
    "data:import": "node scripts/data-corpus/import-data-corpus.mjs",
    "data:validate": "node scripts/data-corpus/validate-data-corpus.mjs",
    "gate:data-corpus": "node scripts/data-corpus/acquire-data-corpus.mjs && node scripts/data-corpus/import-data-corpus.mjs && node scripts/data-corpus/validate-data-corpus.mjs && node --test tests/data-corpus/dataCorpusWave1.test.cjs",
    "test:data-runtime-adapter": "node scripts/run-isolated-domain-suite.cjs data-adapter tests/domain/corpusRuntimeAdapter.test.cjs",
    "test:data-ui-binding": "node scripts/run-isolated-domain-suite.cjs content-binding tests/domain/learnerContentGateway.test.cjs",
    "test:native-corpus": "node scripts/run-isolated-domain-suite.cjs native-corpus tests/domain/nativeCorpusProvisioning.test.cjs",
    "data:snapshots": "node scripts/generate-learner-content-snapshots.cjs",
    "test:data-snapshots": "node scripts/generate-learner-content-snapshots.cjs --check",
    "export:android:hermes": "expo export --platform android --max-workers 1 --output-dir dist-data-ui-hermes",
    "accept:native:android": "powershell -ExecutionPolicy Bypass -File scripts/run-native-corpus-acceptance.ps1"
  },
  "private": true
}
